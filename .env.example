# PayBeforeWork Environment Configuration Template
# Copy this file to .env.local for local development.

# Option A: Local SQLite (Default, runs out of the box with zero external setup)
DATABASE_URL="file:local.db"

# Option B: Turso / Remote libSQL Cloud Database (Optional for hosted production)
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
